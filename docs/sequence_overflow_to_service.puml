@startuml sequence_overflow_to_service
skinparam defaultFontName DejaVu Sans
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam noteBackgroundColor #FFFBE6
autonumber "<b>[0]"

title Вариант 3 — Отказ через переполнение буфера при занятых приборах\nи последующая постановка одной заявки на обработку (N = 3, m = 2, ПЗ2 ∈ [1; 3])

control    "Календарь событий" as Cal
control    "Симулятор"         as Sim
entity     "Источник И1\n(датчик оборудования)" as Src
participant "ДП\n(приём тревог)" as DP
queue      "Буфер (N = 3)" as Buf
participant "ДВ\n(планировщик)" as DV
participant "Прибор П1" as P1
participant "Прибор П2" as P2
database   "Статистика" as Stat

note over Cal, Stat
  <b>Исходное состояние, t = 10,00</b>
  Буфер: [1] И2-5 (tпост = 7,20) | [2] И1-7 (tпост = 8,00) | [3] И3-4 (tпост = 9,50);  УП = 1, УВ = 1
  П1 — занят (И3-3, конец в 12,40);  П2 — занят (И2-4, конец в 11,10)
  Календарь: GENERATION И1 (10,00), SERVICE_END П2 (11,10), SERVICE_END П1 (12,40), GENERATION И2 (13,30), GENERATION И3 (14,80)
end note

== t = 10,00 — триггер GENERATION (И1): буфер полон, приборы заняты ==
Sim -> Cal: pollNext()
Cal --> Sim: GENERATION(t = 10,00, source = 1)
Sim -> Src: generate(10,00)
Src --> Sim: тревога И1-8 «неисправность насоса»
Sim -> Stat: recordGenerated(И1-8)
Stat --> Sim: ok
Sim -> Src: nextArrivalInterval()
note right of Src: <b>ИЗ1</b>: τ = −ln(0,22)/1,0 ≈ 1,51
Src --> Sim: τ = 1,51
Sim -> Cal: schedule(GENERATION, 11,51, source = 1)
Cal --> Sim: ok

Sim -> DP: place(И1-8, 10,00)
DP -> Buf: findFreeSlotByRing(УП = 1)
note right of Buf
  <b>Д1ОЗ1</b> — поиск по кольцу:
  место 1 занято → 2 занято → 3 занято →
  указатель вернулся на 1 — свободных мест нет
end note
Buf --> DP: −1
DP -> Buf: findOldestSlot()
note right of Buf
  <b>Д1ОО3</b> — самая старая в буфере:
  min(7,20; 8,00; 9,50) = 7,20 → место 1 (И2-5)
end note
Buf --> DP: s = 1
DP -> Buf: removeAt(1)
Buf --> DP: И2-5
DP -> DP: И2-5.reject(10,00) — статус REJECTED
DP -> Stat: recordRejected(И2-5)
note right of Stat: отказов И2: +1;\nPотк(И2) = отказы / сгенерировано
Stat --> DP: ok
DP -> Buf: put(1, И1-8)
Buf --> DP: буфер [1] И1-8 | [2] И1-7 | [3] И3-4
DP -> DP: УП := (1 mod 3) + 1 = 2
DP --> Sim: PlacementResult(slot = 1, evicted = И2-5)

Sim -> DV: onRequestBuffered(10,00)
DV -> P1: isFree()
note right of P1: <b>Д2П1</b>: П1 → П2
P1 --> DV: false
DV -> P2: isFree()
P2 --> DV: false
DV -> DV: свободных приборов нет — к буферу не обращаемся
DV --> Sim: dispatch завершён — заявки ждут SERVICE_END

== t = 11,10 — триггер SERVICE_END (П2): одна заявка уходит на обработку ==
Sim -> Cal: pollNext()
Cal --> Sim: SERVICE_END(t = 11,10, device = 2)
Sim -> P2: finishService(11,10)
P2 --> Sim: И2-4 (SERVED)
Sim -> Stat: recordServed(И2-4)
Stat --> Sim: ok
Sim -> DV: onDeviceReleased(11,10)
DV -> P1: isFree()
note right of P1: <b>Д2П1</b>: начинаем с П1
P1 --> DV: false
DV -> P2: isFree()
P2 --> DV: true → выбран П2
DV -> Buf: findOccupiedSlotByRing(УВ = 1)
note right of Buf
  <b>Д2Б3</b> — выбор по кольцу с УВ = 1:
  место 1 занято (И1-8) → берём его
end note
Buf --> DV: q = 1
DV -> Buf: removeAt(1)
Buf --> DV: И1-8; буфер [1] – | [2] И1-7 | [3] И3-4
DV -> DV: УВ := 2
DV -> Stat: recordServiceStart(И1-8, 11,10)
Stat --> DV: ok (Тбп(И1-8) = 1,10)
DV -> P2: startService(И1-8, 11,10)
note right of P2: <b>ПЗ2</b>: Тобсл = 1 + 2·0,40 = 1,80
P2 --> DV: tконца = 12,90
DV -> Cal: schedule(SERVICE_END, 12,90, device = 2)
Cal --> DV: ok
DV -> P1: isFree()
P1 --> DV: false
DV -> P2: isFree()
P2 --> DV: false
DV --> Sim: dispatch завершён (свободных приборов больше нет)

note over Cal, Stat
  <b>Итог, t = 11,10:</b> буфер [ – | И1-7 | И3-4 ], УП = 2, УВ = 2; П1 — И3-3 (до 12,40), П2 — И1-8 (до 12,90).
  Следующая тревога (И1, t = 11,51) по <b>Д1ОЗ1</b> начнёт поиск с УП = 2 → 2 занято → 3 занято → 1 свободно → встанет в место 1, УП := 2.
end note
@enduml

@startuml sequence_edge_cases
skinparam defaultFontName DejaVu Sans
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam noteBackgroundColor #FFFBE6
autonumber "<b>[0]"

title Вариант 3 — Краевые кейсы: постановка в буфер (Д1ОЗ1), выбивание (Д1ОО3),\nвыборка из буфера (Д2Б3), постановка на прибор (Д2П1). Буфер N = 4, приборов m = 3

control    "Симулятор" as Sim
participant "ДП\n(приём тревог)" as DP
queue      "Буфер (N = 4)" as Buf
participant "ДВ\n(планировщик)" as DV
participant "Прибор П1" as P1
participant "Прибор П2" as P2
participant "Прибор П3" as P3
database   "Статистика" as Stat

== Кейс 1. Постановка в буфер с переходом через конец кольца (Д1ОЗ1) ==
note over DP, Buf
  Буфер: [1] – | [2] И1-3 | [3] И2-2 | [4] И3-1;  УП = 2. Все приборы заняты.
end note
Sim -> DP: place(И2-3, t)
DP -> Buf: findFreeSlotByRing(УП = 2)
note right of Buf
  <b>Д1ОЗ1</b>: 2 занято → 3 занято → 4 занято →
  конец буфера, переход на начало → 1 свободно
end note
Buf --> DP: k = 1
DP -> Buf: put(1, И2-3)
Buf --> DP: записано
DP -> DP: УП := 2 (место, следующее за 1)
DP --> Sim: PlacementResult(slot = 1, evicted = null)

== Кейс 2. Отказ — выбивание самой старой заявки (Д1ОО3) ==
note over DP, Buf
  Буфер полон: [1] И2-3 (t=5,1) | [2] И1-3 (t=2,0) | [3] И2-2 (t=3,4) | [4] И3-1 (t=4,0);  УП = 2
end note
Sim -> DP: place(И3-2, t = 6,0)
DP -> Buf: findFreeSlotByRing(УП = 2)
Buf --> DP: −1 (указатель обошёл кольцо и вернулся на 2)
DP -> Buf: findOldestSlot()
note right of Buf: <b>Д1ОО3</b>: min tпост = 2,0 → место 2 (И1-3)
Buf --> DP: s = 2
DP -> Buf: removeAt(2)
Buf --> DP: И1-3
DP -> Stat: recordRejected(И1-3)
Stat --> DP: ok
DP -> Buf: put(2, И3-2)
Buf --> DP: записано
DP -> DP: УП := 3
DP --> Sim: PlacementResult(slot = 2, evicted = И1-3)
note over DP, Stat
  Приборы не отказывают — отказ возможен только в буфере.
  Новая тревога никогда не теряется: теряется самая старая из ожидающих.
end note

== Кейс 3. Выборка из буфера по кольцу с переходом через конец (Д2Б3) ==
note over Buf, DV
  Буфер: [1] И2-3 | [2] – | [3] – | [4] И3-1;  УВ = 2. Освободился П3.
end note
Sim -> DV: onDeviceReleased(t)
DV -> P1: isFree()
P1 --> DV: false
DV -> P2: isFree()
P2 --> DV: false
DV -> P3: isFree()
P3 --> DV: true
DV -> Buf: findOccupiedSlotByRing(УВ = 2)
note right of Buf
  <b>Д2Б3</b>: 2 пусто → 3 пусто → 4 занято
  (по кольцу выбирается И3-1, а не И2-3,
  хотя И2-3 стоит в месте с меньшим номером)
end note
Buf --> DV: q = 4
DV -> Buf: removeAt(4)
Buf --> DV: И3-1
DV -> DV: УВ := 1 (следующее за 4 по кольцу)
DV -> P3: startService(И3-1, t)
note right of P3: <b>ПЗ2</b>: Тобсл = a + (b − a)·r
P3 --> DV: tконца
DV --> Sim: dispatch завершён

== Кейс 4. Постановка на прибор при нескольких свободных (Д2П1) ==
note over DV, P3
  П1 — свободен, П2 — занят, П3 — свободен. Буфер: [1] И1-9, остальные пусты; УВ = 1.
end note
Sim -> DV: onRequestBuffered(t)
loop пока есть свободный прибор и буфер не пуст
  DV -> P1: isFree()
  note right of P1: <b>Д2П1</b>: всегда начинаем с П1 —\nсвободен, П3 не рассматривается
  P1 --> DV: true
  DV -> Buf: findOccupiedSlotByRing(УВ = 1)
  Buf --> DV: q = 1
  DV -> Buf: removeAt(1)
  Buf --> DV: И1-9
  DV -> DV: УВ := 2
  DV -> P1: startService(И1-9, t)
  P1 --> DV: tконца
  DV -> P1: isFree()
  P1 --> DV: false
  DV -> P2: isFree()
  P2 --> DV: false
  DV -> P3: isFree()
  P3 --> DV: true
  DV -> Buf: findOccupiedSlotByRing(УВ = 2)
  Buf --> DV: −1 — буфер пуст, выход из цикла
end
DV --> Sim: dispatch завершён (П3 простаивает)
note over DV, P3
  Следствие Д2П1: П1 загружен сильнее П3 (Кисп П1 ≥ Кисп П2 ≥ Кисп П3).
  Это нужно увидеть в сводной таблице ОР1.
end note
@enduml

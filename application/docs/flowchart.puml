@startuml flowchart
skinparam defaultFontName DejaVu Sans
skinparam ActivityBackgroundColor #F7F9FC
skinparam ActivityDiamondBackgroundColor #FFFBE6
skinparam swimlaneWidth same

title Вариант 3 — Flowchart с дорожками: все альтернативы прохождения тревоги

|Симулятор / Календарь|
start
:Инициализация: t = 0, буфер пуст,
УП = УВ = 1, приборы свободны;
:Для каждого источника Иi запланировать
GENERATION(t = τi), τi по ИЗ1;
repeat
  :e := calendar.pollNext()
  t := e.time;
  if (Тип события?) then (GENERATION)
    |Источник Иi|
    :Сформировать тревогу
    (id, sourceId, тип, объект, tгенер = t);
    |Статистика|
    :recordGenerated(): сгенерировано[i] + 1;
    |Источник Иi|
    if (Сгенерировано < лимита N?) then (да)
      :τ = −ln(r)/λi  (ИЗ1);
      |Симулятор / Календарь|
      :schedule(GENERATION, t + τ);
    else (нет)
      |Источник Иi|
      :Генерация прекращена;
    endif
    |ДП — приём тревог|
    :place(заявка, t);
    |Буфер|
    :Поиск по кольцу с УП
    первого свободного места (Д1ОЗ1);
    if (Свободное место k найдено?) then (да)
      :Записать заявку в место k;
    else (нет: указатель обошёл кольцо)
      :Найти место s с min tпостановки (Д1ОО3);
      :Удалить самую старую заявку из места s;
      |Статистика|
      :recordRejected(): отказы[источник] + 1,
      статус REJECTED;
      |Буфер|
      :Записать новую заявку в место s, k := s;
    endif
    |ДП — приём тревог|
    :УП := место, следующее за k;
    :Триггер для ДВ: «заявка поставлена в буфер»;
  else (SERVICE_END)
    |Прибор Пj|
    :Завершить проверку тревоги,
    накопить время занятости;
    |Статистика|
    :recordServed(): Тпреб, Тобсл, обслужено + 1;
    |Прибор Пj|
    :Триггер для ДВ: «прибор освободился»;
  endif

  |ДВ — планировщик|
  while (Есть свободный прибор? (Д2П1: П1 → Пm)) is (да)
    |Буфер|
    if (Буфер пуст?) then (да)
      |ДВ — планировщик|
      :Прибор простаивает;
      break
    else (нет)
      :Поиск по кольцу с УВ
      первого занятого места q (Д2Б3);
      :Извлечь заявку из места q;
    endif
    |ДВ — планировщик|
    :УВ := место, следующее за q;
    |Статистика|
    :recordServiceStart(): Тбп = t − tпостановки;
    |Прибор Пj|
    :Тобсл = a + (b − a)·r  (ПЗ2);
    :Начать проверку;
    |Симулятор / Календарь|
    :schedule(SERVICE_END, t + Тобсл, Пj);
    |ДВ — планировщик|
  endwhile (нет — заявки ждут в буфере)

  |Симулятор / Календарь|
  :Снимок шага ОД1: t, календарь, буфер,
  УП, УВ, приборы, % отказа;
repeat while (Календарь не пуст?) is (да)
->нет;
|Статистика|
:Сформировать сводную таблицу ОР1:
Pотк, Тпреб, Тбп, Тобсл, Дбп, Добсл, Кисп;
stop
@enduml

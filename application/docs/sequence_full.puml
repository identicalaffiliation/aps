@startuml sequence_full
!pragma teoz true
skinparam defaultFontName DejaVu Sans
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam noteBackgroundColor #FFFBE6
skinparam sequenceGroupBodyBackgroundColor #FFFFFF
autonumber "<b>[0]"

title Вариант 3 — Система обработки промышленных тревог\nОбщий сиквенс: Happy Flow, постановка в буфер, выбивание, выбор из буфера, постановка на прибор

control    "Календарь событий\n(EventCalendar)"               as Cal
control    "Симулятор\n(Simulator)"                          as Sim
entity     "Источник Иi\n(датчик / контроллер / СКУД)"        as Src
participant "ДП — Компонент приёма тревог\n(PlacementDispatcher)" as DP
queue      "Буфер — очередь тревог\n(Buffer, N мест)"         as Buf
participant "ДВ — Планировщик проверки\n(SelectionDispatcher)" as DV
participant "Прибор Пj — рабочий процесс\nанализа (Device)"   as Dev
database   "Статистика\n(StatisticsCollector)"               as Stat

== Инициализация модели (t = 0) ==
loop для каждого источника i = 1..n
  Sim -> Src: nextArrivalInterval()
  note right of Src
    <b>ИЗ1</b> — пуассоновский поток:
    интервал экспоненциальный
    τ = −ln(r) / λi,  r ∈ (0;1)
  end note
  Src --> Sim: τi
  Sim -> Cal: schedule(GENERATION, t = τi, source = i)
  Cal --> Sim: событие запланировано
end

== Главный цикл метода особых событий ==
loop пока календарь не пуст
  Sim -> Cal: pollNext()
  Cal --> Sim: ближайшее событие e (t = e.time)
  Sim -> Sim: currentTime := e.time

  alt <b>Триггер 1:</b> e.type = GENERATION (сгенерирована тревога)
    Sim -> Src: generate(currentTime)
    Src --> Sim: заявка Request (id, sourceId, alarmType, objectId, tгенер)
    Sim -> Stat: recordGenerated(request)
    Stat --> Sim: ok
    opt сгенерировано заявок < лимита N
      Sim -> Src: nextArrivalInterval()  [ИЗ1]
      Src --> Sim: τ
      Sim -> Cal: schedule(GENERATION, currentTime + τ, source = i)
      Cal --> Sim: ok
    end

    Sim -> DP: place(request, currentTime)
    note right of DP
      ДП работает <b>только с буфером</b> и ничего
      не знает о приборах (классический вариант).
    end note
    DP -> Buf: findFreeSlotByRing(putPointer)
    note right of Buf
      <b>Д1ОЗ1</b> — постановка «по кольцу»:
      просмотр мест с позиции указателя УП;
      берётся первое свободное место k.
      Если за N шагов указатель вернулся
      на исходную позицию — мест нет.
    end note
    loop просмотрено < N мест и место занято
      Buf -> Buf: pos := (pos + 1) mod N
    end
    Buf --> DP: k (номер свободного места) или −1

    alt Свободное место найдено (буфер НЕ переполнен)
      DP -> Buf: put(k, request)
      Buf --> DP: заявка записана в место k
    else k = −1: буфер переполнен (а значит, все приборы заняты)
      note right of DP
        Инвариант: если в буфере есть заявки,
        значит, свободных приборов нет (ДВ
        разбирает буфер сразу при свободном
        приборе). Поэтому полный буфер ⇒
        все приборы заняты.
      end note
      DP -> Buf: findOldestSlot()
      note right of Buf
        <b>Д1ОО3</b> — отказ «самой старой в буфере»:
        место s с минимальным tпостановки
        (= tгенер, т.к. источник бесконечный
        и заявка встаёт в буфер сразу).
      end note
      Buf --> DP: s
      DP -> Buf: removeAt(s)
      Buf --> DP: вытесненная заявка old
      DP -> DP: old.reject(currentTime)
      DP -> Stat: recordRejected(old)
      Stat --> DP: ok (Pотк пересчитана)
      DP -> Buf: put(s, request)
      Buf --> DP: новая тревога записана в место s
      DP -> DP: k := s
    end
    DP -> DP: putPointer := (k + 1) mod N
    DP --> Sim: PlacementResult(slot = k, evicted = old | null)

    Sim -> DV: onRequestBuffered(currentTime)
    note right of DV
      <b>Триггер для ДВ №1:</b> «заявка поставлена в буфер».
      Нужен для Happy Flow, когда прибор простаивает.
    end note

  else <b>Триггер 2:</b> e.type = SERVICE_END (прибор Пj закончил проверку)
    Sim -> Dev: finishService(currentTime)
    Dev --> Sim: обслуженная заявка (статус SERVED)
    Sim -> Stat: recordServed(request)
    Stat --> Sim: ok (Тпреб, Тобсл, Кисп обновлены)
    Sim -> DV: onDeviceReleased(currentTime)
    note right of DV
      <b>Триггер для ДВ №2:</b> «прибор освободился».
    end note
  end

  group ДВ.dispatch(currentTime) — общий для обоих триггеров
    loop пока есть свободный прибор И буфер не пуст
      DV -> Dev: найти свободный прибор (isFree() по j = 1..m)
      note right of Dev
        <b>Д2П1</b> — приоритет по номеру прибора:
        перебор всегда начинается с П1,
        берётся первый свободный.
      end note
      Dev --> DV: Пj или null
      alt Все приборы заняты
        DV -> DV: выход из цикла — заявки ждут в буфере\n(ожидание события SERVICE_END)
      else Найден свободный прибор Пj
        DV -> Buf: findOccupiedSlotByRing(takePointer)
        note right of Buf
          <b>Д2Б3</b> — выбор из буфера «по кольцу»:
          поиск с позиции указателя УВ,
          берётся первое занятое место q.
        end note
        alt Буфер пуст
          Buf --> DV: −1
          DV -> DV: выход из цикла — прибор Пj простаивает
        else Найдена заявка
          Buf --> DV: q
          DV -> Buf: removeAt(q)
          Buf --> DV: заявка request
          DV -> DV: takePointer := (q + 1) mod N
          DV -> Stat: recordServiceStart(request, currentTime)
          Stat --> DV: ok (Тбп учтено)
          DV -> Dev: startService(request, currentTime)
          note right of Dev
            <b>ПЗ2</b> — равномерный закон:
            Тобсл = a + (b − a)·r
          end note
          Dev --> DV: tконца = currentTime + Тобсл
          DV -> Cal: schedule(SERVICE_END, tконца, device = j)
          Cal --> DV: ok
        end
      end
    end
    DV --> Sim: dispatch завершён
  end

  Sim -> Sim: snapshot() для ОД1\n(t, календарь, буфер, УП, УВ, приборы, %отказа)
end

Sim -> Stat: buildResults(currentTime)
Stat --> Sim: ResultsTable (ОР1 — сводная таблица)
@enduml

@startuml sequence_simple
skinparam defaultFontName DejaVu Sans
skinparam responseMessageBelowArrow true
skinparam noteBackgroundColor #FFFBE6
skinparam sequenceMessageAlign left
autonumber "<b>[0]"

title Вариант 3 — Обработка тревоги (упрощённый сиквенс)

actor       "Источник\n(датчик / контроллер / СКУД)" as Src
participant "ДП\n(приём тревог)"     as DP
queue       "Буфер\n(очередь тревог)"  as Buf
participant "ДВ\n(планировщик)"      as DV
participant "Прибор\n(рабочий процесс)" as Dev

== Пришла тревога ==
Src -> DP: Новая тревога\n<b>[ИЗ1]</b> интервал τ = −ln(r)/λ
DP -> Buf: Найти свободное место по кольцу с УП\n<b>[Д1ОЗ1]</b>
alt Место есть
  Buf --> DP: Место k
else Буфер полон (значит, все приборы заняты)
  Buf --> DP: Мест нет
  DP -> Buf: Удалить самую старую тревогу\n<b>[Д1ОО3]</b>
  Buf --> DP: Удалена → <b>ОТКАЗ</b> (+1 в статистику)
end
DP -> Buf: Положить тревогу, УП := следующее место
Buf --> DP: Готово
DP -> DV: Тревога в буфере <i>(триггер)</i>

DV -> Dev: Есть свободный прибор?\n<b>[Д2П1]</b> перебор с П1
alt Все приборы заняты
  Dev --> DV: Нет → тревога ждёт в буфере
else Свободен прибор Пj (Happy Flow)
  Dev --> DV: Пj
  DV -> Buf: Взять тревогу по кольцу с УВ\n<b>[Д2Б3]</b>
  Buf --> DV: Тревога, УВ := следующее место
  DV -> Dev: Начать проверку\n<b>[ПЗ2]</b> Тобсл = a + (b − a)·r
  Dev --> DV: Принято
end

== Прибор освободился ==
Dev -> DV: Проверка завершена <i>(триггер)</i>\nинцидент зарегистрирован
DV -> Buf: Взять тревогу по кольцу с УВ\n<b>[Д2Б3]</b>
alt Буфер пуст
  Buf --> DV: Пусто → прибор простаивает
else Есть тревоги
  Buf --> DV: Тревога, УВ := следующее место
  DV -> Dev: Начать проверку на первом свободном\n<b>[Д2П1]</b>, <b>[ПЗ2]</b>
  Dev --> DV: Принято
end
@enduml

@startuml flowchart_simple
skinparam defaultFontName DejaVu Sans
skinparam ActivityDiamondBackgroundColor #FFFBE6

title Вариант 3 — Путь тревоги (упрощённый flowchart)

|Источник|
start
:Сгенерировать тревогу (ИЗ1);
|ДП|
if (Есть свободное место?\nпоиск по кольцу, Д1ОЗ1) then (да)
else (нет)
  |Буфер|
  :Удалить самую старую тревогу
  → ОТКАЗ (Д1ОО3);
endif
|Буфер|
:Положить тревогу, сдвинуть УП;
|ДВ|
repeat
  if (Есть свободный прибор?\nс П1, Д2П1) then (нет)
    :Тревога ждёт в буфере;
    |Прибор|
    :...пока какой-то прибор
    не закончит проверку;
  else (да)
  endif
  |ДВ|
  :Взять тревогу по кольцу
  с УВ, сдвинуть УВ (Д2Б3);
  |Прибор|
  :Проверить тревогу (ПЗ2);
  :Прибор освободился;
  |ДВ|
repeat while (В буфере есть тревоги?) is (да)
->нет;
:Прибор простаивает;
stop
@enduml

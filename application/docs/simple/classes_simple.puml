@startuml classes_simple
skinparam defaultFontName DejaVu Sans
skinparam classAttributeIconSize 0
hide empty members

title Вариант 3 — Диаграмма классов (упрощённая)

class Request <<Тревога>> {
  - sourceId: int
  - createdAt: float
  - bufferedAt: float
}

class Source <<Источник, ИЗ1>> {
  - id: int
  - lambda: float
  + generate(now: float): Request
  + nextInterval(): float
}

class Buffer <<Очередь тревог>> {
  - slots: Request[N]
  + findFree(from: int): int
  + findBusy(from: int): int
  + findOldest(): int
  + put(i: int, r: Request)
  + take(i: int): Request
}

class Device <<Прибор, ПЗ2>> {
  - id: int
  - current: Request
  + isFree(): bool
  + start(r: Request, now: float): float
  + finish(): Request
}

class PlacementDispatcher <<ДП>> {
  - buffer: Buffer
  - stats: Statistics
  - putPointer: int
  + place(r: Request, now: float)
}

class SelectionDispatcher <<ДВ>> {
  - buffer: Buffer
  - devices: Device[]
  - stats: Statistics
  - takePointer: int
  + onRequestBuffered(now: float)
  + onDeviceFreed(now: float)
}

class Statistics {
  + generated(r: Request)
  + rejected(r: Request)
  + served(r: Request)
  + table(): ResultsTable
}

class Simulator {
  - calendar: EventQueue
  - sources: Source[]
  - dp: PlacementDispatcher
  - dv: SelectionDispatcher
  + step()
  + run()
}

PlacementDispatcher --> Buffer : - buffer
PlacementDispatcher --> Statistics : - stats
SelectionDispatcher --> Buffer : - buffer
SelectionDispatcher --> Device : - devices
SelectionDispatcher --> Statistics : - stats
Buffer o-- Request
Device --> Request : - current
Source ..> Request : создаёт
Simulator *-- Source
Simulator *-- PlacementDispatcher
Simulator *-- SelectionDispatcher
@enduml

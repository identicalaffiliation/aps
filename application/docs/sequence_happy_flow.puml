@startuml sequence_happy_flow
skinparam defaultFontName DejaVu Sans
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam noteBackgroundColor #FFFBE6
autonumber "<b>[0]"

title Вариант 3 — Happy Flow: буфер пуст, прибор свободен\nКонфигурация примера: n = 3 источника, N = 3 места буфера, m = 2 прибора, ПЗ2 ∈ [1; 3]

control    "Календарь событий" as Cal
control    "Симулятор"         as Sim
entity     "Источник И2\n(контроллер линии)" as Src
participant "ДП\n(приём тревог)" as DP
queue      "Буфер\nУП = 1, УВ = 1\n[ – | – | – ]" as Buf
participant "ДВ\n(планировщик)" as DV
participant "Прибор П1" as P1
participant "Прибор П2" as P2
database   "Статистика" as Stat

note over Cal, Sim
  В календаре: GENERATION И1 (t = 4,20), И2 (t = 0,84), И3 (t = 5,05).
  Других событий до t = 3,54 нет.
end note
== t = 0,84 — триггер GENERATION (И2) ==
Sim -> Cal: pollNext()
Cal --> Sim: GENERATION(t = 0,84, source = 2)
Sim -> Src: generate(0,84)
Src --> Sim: тревога И2-1 «превышение порога давления»
Sim -> Stat: recordGenerated(И2-1)
Stat --> Sim: ok
Sim -> Src: nextArrivalInterval()
note right of Src: <b>ИЗ1</b>: τ = −ln(r)/λ2 = −ln(0,084)/0,8 ≈ 3,10
Src --> Sim: τ = 3,10
Sim -> Cal: schedule(GENERATION, 3,94, source = 2)
Cal --> Sim: ok

Sim -> DP: place(И2-1, 0,84)
DP -> Buf: findFreeSlotByRing(УП = 1)
note right of Buf: <b>Д1ОЗ1</b>: место 1 свободно — поиск закончен на первом шаге
Buf --> DP: k = 1
DP -> Buf: put(1, И2-1)
Buf --> DP: записано; буфер [ И2-1 | – | – ]
DP -> DP: УП := 2
DP --> Sim: PlacementResult(slot = 1, evicted = null)

Sim -> DV: onRequestBuffered(0,84)
DV -> P1: isFree()
note right of P1: <b>Д2П1</b>: перебор с П1 — П1 свободен, дальше не смотрим
P1 --> DV: true
DV -> Buf: findOccupiedSlotByRing(УВ = 1)
note right of Buf: <b>Д2Б3</b>: место 1 занято
Buf --> DV: q = 1
DV -> Buf: removeAt(1)
Buf --> DV: И2-1; буфер [ – | – | – ]
DV -> DV: УВ := 2
DV -> Stat: recordServiceStart(И2-1, 0,84)
Stat --> DV: ok (Тбп = 0)
DV -> P1: startService(И2-1, 0,84)
note right of P1: <b>ПЗ2</b>: Тобсл = 1 + (3 − 1)·0,85 = 2,70
P1 --> DV: tконца = 3,54
DV -> Cal: schedule(SERVICE_END, 3,54, device = 1)
Cal --> DV: ok
DV -> P1: isFree()
P1 --> DV: false
DV -> P2: isFree()
P2 --> DV: true
DV -> Buf: findOccupiedSlotByRing(УВ = 2)
Buf --> DV: −1 (буфер пуст)
DV --> Sim: dispatch завершён (П2 простаивает)

== t = 3,54 — триггер SERVICE_END (П1) ==
Sim -> Cal: pollNext()
Cal --> Sim: SERVICE_END(t = 3,54, device = 1)
Sim -> P1: finishService(3,54)
P1 --> Sim: И2-1 (SERVED, инцидент зарегистрирован)
Sim -> Stat: recordServed(И2-1)
Stat --> Sim: ok (Тпреб = 2,70)
Sim -> DV: onDeviceReleased(3,54)
DV -> P1: isFree()
P1 --> DV: true
DV -> Buf: findOccupiedSlotByRing(УВ = 2)
Buf --> DV: −1 (буфер пуст)
DV --> Sim: dispatch завершён (П1 простаивает)
@enduml
